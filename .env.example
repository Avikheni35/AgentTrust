# ── App ──────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-32-char-string
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://agenttrust:agenttrust@postgres:5432/agenttrust

# ── OpenAI ───────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# ── Keycloak (Auth) ───────────────────────────────────
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=agenttrust
KEYCLOAK_CLIENT_ID=agenttrust-backend
KEYCLOAK_CLIENT_SECRET=change-me

# ── Redis ────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Object Storage (Oracle / S3-compatible) ───────────
STORAGE_ENDPOINT=https://objectstorage.eu-frankfurt-1.oraclecloud.com
STORAGE_BUCKET=agenttrust-documents
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ── Defaults ─────────────────────────────────────────
DEFAULT_CHUNK_SIZE=512
DEFAULT_CHUNK_OVERLAP=50
MAX_RETRIEVAL_CHUNKS=8
